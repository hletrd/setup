#!/usr/bin/env node
/**
 * codex-task — submit and manage tasks for a general codex-loop worker.
 *
 * The loop runs from a NEUTRAL, empty workspace (e.g.
 * ~/flash-shared/codex-workspaces/<host>/), not a specific repo. Each task
 * carries its own context — "in /path/to/repo, do X" — and the resident worker
 * (full access) operates on whatever path the task names. This tool is the
 * task+queue front-end over that worker's file queue.
 *
 * Lifecycle (all inferred from file location — no codex-loop changes needed):
 *   submit → queue/<id>.task            PENDING/QUEUED
 *   loop picks oldest, works it         RUNNING  (oldest queue file + loop alive)
 *   loop moves it to done/, writes .out DONE
 *   (cross-host drops land in inbox/    PENDING until the watchdog drains them)
 *
 * Task id: YYYYMMDD-HHMMSS-<hex> — time-sortable, so codex-loop's `ls|sort`
 * queue order stays FIFO, and the id is stable across queue→done.
 *
 * Target loop: resolved from ~/.codex-loop/watchdog.json — the single managed
 * loop, or pass --cwd DIR to pick one explicitly.
 *
 * Commands:
 *   codex-task submit [--cwd DIR] [--repo PATH] [--file F | "TEXT"]   enqueue; prints id
 *   codex-task ls   [--cwd DIR] [--state S] [--json]                  list tasks + state
 *   codex-task show <id> [--cwd DIR]                                  task text + output + state
 *   codex-task log  <id> [--cwd DIR] [-f]                             show/follow the task .out
 *   codex-task rm   <id> [--cwd DIR]                                  drop a pending/queued task
 *   codex-task stats [--cwd DIR]                                      counts by state
 *   codex-task purge [--older-than DAYS] [--cwd DIR] [--yes]          delete old DONE tasks + logs
 *   codex-task where [--cwd DIR]                                      print the resolved loop dirs
 */

import { spawn } from 'node:child_process';
import { createHash, randomBytes } from 'node:crypto';
import {
  existsSync, mkdirSync, writeFileSync, readFileSync, readdirSync, statSync, unlinkSync,
} from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const ROOT = join(homedir(), '.codex-loop');
const WATCHDOG_CONFIG = join(ROOT, 'watchdog.json');

function baseDirFor(cwd) {
  return join(ROOT, createHash('sha256').update(cwd).digest('hex').slice(0, 12));
}

function readJson(p, fallback) {
  try { return JSON.parse(readFileSync(p, 'utf-8')); } catch { return fallback; }
}

function pidAlive(pid) { try { process.kill(pid, 0); return true; } catch { return false; } }
function loopPid(base) {
  try { const p = parseInt(readFileSync(join(base, 'loop.pid'), 'utf-8'), 10); return Number.isFinite(p) ? p : null; } catch { return null; }
}
function loopAlive(base) { const p = loopPid(base); return !!(p && pidAlive(p)); }

/** Resolve the target loop {cwd, base, inbox} from --cwd or watchdog.json. */
function resolveLoop(flags) {
  if (flags.cwd) {
    const cfg = readJson(WATCHDOG_CONFIG, { loops: [] });
    const m = (cfg.loops || []).find((l) => l.cwd === flags.cwd);
    return { cwd: flags.cwd, base: baseDirFor(flags.cwd), inbox: (m && m.inbox) || null };
  }
  const cfg = readJson(WATCHDOG_CONFIG, { loops: [] });
  const loops = cfg.loops || [];
  if (loops.length === 1) return { cwd: loops[0].cwd, base: baseDirFor(loops[0].cwd), inbox: loops[0].inbox || null };
  if (loops.length === 0) {
    fail('no codex-loop is registered. Register one, e.g.:\n  codex-loop-watchdog add --cwd ~/flash-shared/codex-workspaces/<host> --inbox ~/flash-shared/codex-workspaces/<host>/inbox\nor pass --cwd DIR.');
  }
  fail(`multiple loops registered — pass --cwd DIR. Registered:\n  ${loops.map((l) => l.cwd).join('\n  ')}`);
}

function fail(msg, code = 1) { console.error(`codex-task: ${msg}`); process.exit(code); }

function pad2(n) { return String(n).padStart(2, '0'); }
function makeId() {
  const d = new Date();
  const stamp = `${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}-${pad2(d.getHours())}${pad2(d.getMinutes())}${pad2(d.getSeconds())}`;
  return `${stamp}-${randomBytes(2).toString('hex')}`;
}

function listTasks(dir) {
  try { return readdirSync(dir).filter((f) => f.endsWith('.task')).sort(); } catch { return []; }
}
function firstLine(text) {
  for (const ln of text.split('\n')) { const t = ln.trim(); if (t) return t; }
  return '';
}
function fmtAge(ms) {
  const s = Math.max(0, Math.floor((Date.now() - ms) / 1000));
  if (s < 60) return `${s}s`;
  const m = Math.floor(s / 60); if (m < 60) return `${m}m`;
  const h = Math.floor(m / 60); if (h < 24) return `${h}h${pad2(m % 60)}m`;
  return `${Math.floor(h / 24)}d${pad2(h % 24)}h`;
}
function idFromName(name) { return name.replace(/\.task$/, '').replace(/^\d{6}-/, ''); } // strip codex-loop seq prefix if any

/** Enumerate every task across queue/done/inbox with its state. */
function enumerate(loop) {
  const { base, inbox } = loop;
  const alive = loopAlive(base);
  const out = [];
  const queue = listTasks(join(base, 'queue'));
  const oldest = queue[0];
  for (const name of queue) {
    const p = join(base, 'queue', name);
    out.push({ id: idFromName(name), name, dir: 'queue', path: p,
      state: alive && name === oldest ? 'RUNNING' : 'QUEUED', mtime: safeMtime(p) });
  }
  for (const name of listTasks(join(base, 'done'))) {
    const p = join(base, 'done', name);
    out.push({ id: idFromName(name), name, dir: 'done', path: p, state: 'DONE', mtime: safeMtime(p) });
  }
  if (inbox) {
    for (const name of listTasks(inbox)) {
      const p = join(inbox, name);
      out.push({ id: idFromName(name), name, dir: 'inbox', path: p, state: 'PENDING', mtime: safeMtime(p) });
    }
  }
  out.sort((a, b) => (a.mtime - b.mtime) || a.name.localeCompare(b.name));
  return out;
}
function safeMtime(p) { try { return statSync(p).mtimeMs; } catch { return 0; } }

/** Locate a task by id (or unambiguous prefix) across queue/done/inbox. */
function findTask(loop, id) {
  const all = enumerate(loop);
  let hits = all.filter((t) => t.id === id || t.name.includes(id));
  if (hits.length === 0) return null;
  if (hits.length > 1) {
    // prefer an exact id match if present
    const exact = hits.filter((t) => t.id === id);
    if (exact.length === 1) return exact[0];
    fail(`ambiguous id "${id}" — matches ${hits.length}:\n  ${hits.map((t) => t.name).join('\n  ')}`);
  }
  return hits[0];
}

function taskLogFile(loop, task) {
  const logDir = join(loop.base, 'log');
  try {
    const cands = readdirSync(logDir).filter((f) => f.includes(task.id) || f.includes(task.name.replace(/\.task$/, '')));
    if (cands.length) return join(logDir, cands.sort().reverse()[0]);
  } catch { /* none */ }
  return null;
}

// ── commands ──────────────────────────────────────────────────────────────────
function cmdSubmit(flags) {
  const loop = resolveLoop(flags);
  let text = flags._.join(' ').trim();
  if (flags.file) {
    try { text = readFileSync(flags.file, 'utf-8'); } catch (e) { fail(`cannot read --file ${flags.file}: ${e}`); }
  }
  if (!text.trim()) {
    try { text = readFileSync(0, 'utf-8'); } catch { /* no stdin */ }
  }
  text = text.trim();
  if (!text) fail('no task text (pass "TEXT", --file F, or pipe stdin)');
  if (flags.repo) text = `Work in repository: ${flags.repo}\n\n${text}`;
  const queue = join(loop.base, 'queue');
  mkdirSync(queue, { recursive: true });
  const id = makeId();
  const p = join(queue, `${id}.task`);
  writeFileSync(p, text.endsWith('\n') ? text : text + '\n', { mode: 0o600 });
  const alive = loopAlive(loop.base);
  console.log(id + (alive ? '' : '  (queued — loop not running; start it or enable the watchdog)'));
}

function cmdLs(flags) {
  const loop = resolveLoop(flags);
  let rows = enumerate(loop);
  if (flags.state) rows = rows.filter((t) => t.state === flags.state.toUpperCase());
  if (flags.json) { console.log(JSON.stringify(rows.map(({ id, state, dir, name, mtime }) => ({ id, state, dir, name, mtime })), null, 2)); return; }
  if (!rows.length) { console.log('(no tasks)'); return; }
  console.log(`loop: ${loop.cwd}  [${loopAlive(loop.base) ? 'RUNNING' : 'stopped'}]`);
  console.log('ID                     STATE    AGE     TASK');
  for (const t of rows) {
    let text = ''; try { text = firstLine(readFileSync(t.path, 'utf-8')); } catch { /* gone */ }
    console.log(`${t.id.padEnd(22)} ${t.state.padEnd(8)} ${fmtAge(t.mtime).padEnd(7)} ${text.slice(0, 60)}`);
  }
}

function cmdShow(flags) {
  const loop = resolveLoop(flags);
  const id = flags._[0]; if (!id) fail('usage: codex-task show <id>');
  const t = findTask(loop, id); if (!t) fail(`no task matching "${id}"`);
  console.log(`id:    ${t.id}\nstate: ${t.state}\nfile:  ${t.path}`);
  console.log('\n── task ──');
  try { process.stdout.write(readFileSync(t.path, 'utf-8')); } catch { console.log('(task file gone)'); }
  const logf = taskLogFile(loop, t);
  if (logf) { console.log(`\n── output (${logf}) ──`); try { process.stdout.write(readFileSync(logf, 'utf-8')); } catch { /* gone */ } }
  else console.log('\n(no output log yet)');
}

function cmdLog(flags) {
  const loop = resolveLoop(flags);
  const id = flags._[0]; if (!id) fail('usage: codex-task log <id> [-f]');
  const t = findTask(loop, id); if (!t) fail(`no task matching "${id}"`);
  const logf = taskLogFile(loop, t);
  if (!logf) fail('no output log for this task yet');
  if (flags.f) {
    const tail = spawn('tail', ['-f', logf], { stdio: 'inherit' });
    process.on('SIGINT', () => { try { tail.kill(); } catch {} process.exit(0); });
  } else {
    try { process.stdout.write(readFileSync(logf, 'utf-8')); } catch { fail('log gone'); }
  }
}

function cmdRm(flags) {
  const loop = resolveLoop(flags);
  const id = flags._[0]; if (!id) fail('usage: codex-task rm <id>');
  const t = findTask(loop, id); if (!t) fail(`no task matching "${id}"`);
  if (t.state === 'RUNNING') fail(`"${t.id}" is RUNNING — cannot safely interrupt it. Use \`codex-loop stop\` to halt the worker.`, 2);
  if (t.state === 'DONE') fail(`"${t.id}" is already DONE (use \`codex-task purge\` to clean done tasks)`, 2);
  try { unlinkSync(t.path); console.log(`removed ${t.id} (${t.state})`); } catch (e) { fail(`could not remove: ${e}`); }
}

function cmdStats(flags) {
  const loop = resolveLoop(flags);
  const rows = enumerate(loop);
  const c = { PENDING: 0, QUEUED: 0, RUNNING: 0, DONE: 0 };
  for (const t of rows) c[t.state] = (c[t.state] || 0) + 1;
  console.log(JSON.stringify({ cwd: loop.cwd, alive: loopAlive(loop.base), ...c, total: rows.length }));
}

function cmdPurge(flags) {
  const loop = resolveLoop(flags);
  const days = flags['older-than'] != null ? Number(flags['older-than']) : 7;
  if (!Number.isFinite(days) || days < 0) fail('--older-than must be a non-negative number of days');
  const cutoff = Date.now() - days * 86400_000;
  const doneDir = join(loop.base, 'done');
  const logDir = join(loop.base, 'log');
  const victims = [];
  for (const name of listTasks(doneDir)) { const p = join(doneDir, name); if (safeMtime(p) < cutoff) victims.push(p); }
  try { for (const f of readdirSync(logDir)) { const p = join(logDir, f); if (safeMtime(p) < cutoff) victims.push(p); } } catch { /* none */ }
  if (!victims.length) { console.log(`nothing to purge (DONE/log older than ${days}d)`); return; }
  if (!flags.yes) { console.log(`would delete ${victims.length} file(s) older than ${days}d from done/ and log/. Re-run with --yes.`); return; }
  let n = 0; for (const p of victims) { try { unlinkSync(p); n++; } catch { /* skip */ } }
  console.log(`purged ${n} file(s)`);
}

function cmdWhere(flags) {
  const loop = resolveLoop(flags);
  console.log(JSON.stringify({ cwd: loop.cwd, base: loop.base, queue: join(loop.base, 'queue'),
    done: join(loop.base, 'done'), log: join(loop.base, 'log'), inbox: loop.inbox, alive: loopAlive(loop.base) }, null, 2));
}

// ── CLI parsing ────────────────────────────────────────────────────────────────
function parseFlags(argv) {
  const o = { _: [] };
  const rest = [...argv];
  while (rest.length) {
    const a = rest.shift();
    if (a === '--cwd') o.cwd = rest.shift();
    else if (a === '--repo') o.repo = rest.shift();
    else if (a === '--file') o.file = rest.shift();
    else if (a === '--state') o.state = rest.shift();
    else if (a === '--older-than') o['older-than'] = rest.shift();
    else if (a === '--json') o.json = true;
    else if (a === '--yes' || a === '-y') o.yes = true;
    else if (a === '-f' || a === '--follow') o.f = true;
    else o._.push(a);
  }
  return o;
}

function main() {
  const [mode, ...argv] = process.argv.slice(2);
  const flags = parseFlags(argv);
  switch (mode) {
    case 'submit': case 'add': return cmdSubmit(flags);
    case 'ls': case 'list': return cmdLs(flags);
    case 'show': return cmdShow(flags);
    case 'log': return cmdLog(flags);
    case 'rm': case 'remove': return cmdRm(flags);
    case 'stats': return cmdStats(flags);
    case 'purge': return cmdPurge(flags);
    case 'where': return cmdWhere(flags);
    default:
      console.log(`codex-task — submit and manage tasks for a general codex-loop worker

  codex-task submit [--cwd DIR] [--repo PATH] [--file F | "TEXT"]   enqueue a task, prints its id
  codex-task ls    [--cwd DIR] [--state PENDING|QUEUED|RUNNING|DONE] [--json]
  codex-task show  <id> [--cwd DIR]                                task text + output + state
  codex-task log   <id> [--cwd DIR] [-f]                           show/follow the task .out
  codex-task rm    <id> [--cwd DIR]                                drop a pending/queued task
  codex-task stats [--cwd DIR]                                     counts by state
  codex-task purge [--older-than DAYS] [--cwd DIR] [--yes]         delete old DONE tasks + logs
  codex-task where [--cwd DIR]                                     print resolved loop dirs

Target loop is read from ~/.codex-loop/watchdog.json (the single registered
loop), or pass --cwd DIR. Tasks run from a neutral workspace — put the repo
path in the task text (or use --repo PATH).`);
      process.exit(mode ? 0 : 2);
  }
}

import { pathToFileURL } from 'node:url';
const isEntry = (() => { try { return !!process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href; } catch { return true; } })();
if (isEntry) main();

export {
  baseDirFor, resolveLoop, makeId, enumerate, findTask, taskLogFile, idFromName,
  firstLine, fmtAge, loopAlive, readJson,
};
