# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Zinit initialization
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
[ -f "$ZINIT_HOME/zinit.zsh" ] && source "$ZINIT_HOME/zinit.zsh"

# Zinit plugins
zinit ice depth=1; zinit light romkatv/powerlevel10k
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-syntax-highlighting

# History configuration
HISTFILE=~/.histfile
HISTSIZE=100000
SAVEHIST=100000

# Shell options
setopt autocd
bindkey -e

# Reset stale mouse tracking modes (fixes garbled input after SSH disconnect)
autoload -Uz add-zsh-hook
_reset_mouse_tracking() { printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l'; }
add-zsh-hook precmd _reset_mouse_tracking

# Completion
autoload -Uz compinit
compinit

# Environment variables
export EDITOR=vim
export VISUAL=vim

# PATH configuration
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

# fnm (fast node manager)
export PATH="$HOME/.local/share/fnm:$PATH"
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd)"

# Load local environment
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Docker CLI (macOS Docker Desktop)
export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"
fpath=($HOME/.docker/completions $fpath)

# FZF
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Modern CLI tool aliases (only if tools exist)
command -v eza >/dev/null && alias ls="eza" && alias ll="eza -l" && alias la="eza -la"
#command -v bat >/dev/null # && alias cat="bat"
command -v fd >/dev/null && alias find="fd"
#command -v rg >/dev/null # && alias grep="rg"
command -v dust >/dev/null && alias du="dust"
command -v duf >/dev/null && alias df="duf"
command -v btm >/dev/null && alias top="btm"
#command -v procs >/dev/null && alias ps="procs"
#command -v sd >/dev/null # && alias sed="sd"
#command -v gping >/dev/null && alias ping="gping"
command -v difft >/dev/null && alias diff="difft"
command -v xh >/dev/null && alias http="xh"
command -v lazygit >/dev/null && alias lg="lazygit"
command -v lazydocker >/dev/null && alias lzd="lazydocker"
command -v choose >/dev/null && alias cut="choose"
# claude/codex/opencode wrappers: `BASH_ENV=""` and `ENV=""` stop child bash/sh subshells from sourcing any startup file, so interactive-only aliases from this zshrc never leak into agent tool invocations. The tools still see POSIX-standard `ls`, `grep`, `cat`, etc.
alias claude='BASH_ENV="" ENV="" command claude --dangerously-skip-permissions'
alias c="claude"

# Broot (file navigator)
[ -f ~/.config/broot/launcher/bash/br ] && source ~/.config/broot/launcher/bash/br

# Atuin (shell history)
command -v atuin >/dev/null && eval "$(atuin init zsh)"

# mcfly (shell history)
command -v mcfly >/dev/null && eval "$(mcfly init zsh)"

# acme.sh
[ -f "$HOME/.acme.sh/acme.sh.env" ] && . "$HOME/.acme.sh/acme.sh.env"

# Powerlevel10k configuration
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
infocmp -x -A /usr/share/terminfo "$TERM" >/dev/null 2>&1 && export TERMINFO=/usr/share/terminfo

# opencode config
export OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1 # Disable only ~/.claude/CLAUDE.md

alias codex='BASH_ENV="" ENV="" command codex --dangerously-bypass-approvals-and-sandbox'
command -v zellij >/dev/null && alias zl="zellij"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
alias opencode='BASH_ENV="" ENV="" command opencode'

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Claude Code against the self-hosted H200 (xylolabs). Same shape as ck/cg.
#
# The backend speaks Anthropic's wire format natively -- content blocks, usage --
# so Claude Code needs no adapter. PROXY_ALIAS_REWRITE_ALL rewrites every model
# id to whatever the H200 is actually serving, so XYLOLABS_H200_MODEL is
# cosmetic; it is set so /model and the usage logs read truthfully.
#
# The key is NOT stored here. Put it in ~/.config/xylolabs/h200-key (chmod 600)
# or export XYLOLABS_H200_KEY.
#
# GLM reasons on every request and the proxy strips the thinking blocks back out
# for clients that did not ask for them -- without that stripping, Claude Code
# under a non-Claude model id renders the reasoning as its reply. Reasoning is
# not free: 560 completion tokens / 3.4 s against 87 / 0.7 s for the same
# arithmetic prompt. For a faster, non-reasoning session:
#
#   XYLOLABS_H200_MODEL=glm-5.2-superglm-nonthinking cl
#
# Left on by default because coding work is where the reasoning earns its keep.
: "${XYLOLABS_H200_URL:=https://gpu.internal.xylolabs.com}"
: "${XYLOLABS_H200_MODEL:=glm-5.2-superglm}"

claude_with_local_env() {
    local key="${XYLOLABS_H200_KEY:-}"
    if [ -z "$key" ] && [ -r "$HOME/.config/xylolabs/h200-key" ]; then
        key=$(< "$HOME/.config/xylolabs/h200-key")
    fi
    if [ -z "$key" ]; then
        print -u2 "cl: no API key. Put one in ~/.config/xylolabs/h200-key (chmod 600)"
        print -u2 "    or export XYLOLABS_H200_KEY. Get one from $XYLOLABS_H200_URL/"
        return 1
    fi
    # CLAUDE_CODE_AUTO_COMPACT_WINDOW must not exceed the engine's
    # --max-model-len, or a conversation grows past the context and every
    # request 400s. The H200 serves 1,048,576.
    BASH_ENV="" \
    ENV="" \
    ANTHROPIC_AUTH_TOKEN="$key" \
    ANTHROPIC_BASE_URL="$XYLOLABS_H200_URL" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$XYLOLABS_H200_MODEL" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="$XYLOLABS_H200_MODEL" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="$XYLOLABS_H200_MODEL" \
    CLAUDE_CODE_SUBAGENT_MODEL="$XYLOLABS_H200_MODEL" \
    CLAUDE_CODE_AUTO_COMPACT_WINDOW="1000000" \
    API_TIMEOUT_MS="3000000" \
    CLAUDE_CODE_ATTRIBUTION_HEADER="0" \
    command claude --dangerously-skip-permissions "$@"
}
alias cl=claude_with_local_env

# Zoxide (smart cd) — MUST be the very last thing in this file per the zoxide docs; anything added after it should go into a separate file sourced from here, not inline below.
command -v zoxide >/dev/null && eval "$(zoxide init zsh)" && alias cd="z"
