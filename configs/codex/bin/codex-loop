#!/usr/bin/env node
/**
 * codex-loop — keep ONE Codex turn alive forever and feed it work through a
 * file queue, so new work rides across the 5h usage-limit window.
 *
 * WHY THIS WORKS (measured, 2026-07-16):
 *   The workspace spend-cap gate is enforced at the *start of each new
 *   top-level turn*. A brand-new `codex exec` / `codex-reply` / fresh TUI all
 *   open a new top-level turn → gated at 100%. But a turn that is ALREADY
 *   running keeps issuing model requests that pass even at primary=100%
 *   (observed one live subagent make 45/57 model requests while primary was
 *   100%). So instead of sending a new prompt per task, we start ONE long turn
 *   whose instructions are: "poll this queue file forever; run each task;
 *   never finish." New tasks are appended to the queue file; the live turn
 *   picks them up without ever opening a new top-level turn.
 *
 *   IMPORTANT: the initial `codex exec` that opens the loop still has to pass
 *   the gate ONCE. Start it while the window has headroom (or right after a
 *   reset); after that it survives the next 100% window.
 *
 * Layout (per working dir, keyed by a hash):
 *   ~/.codex-loop/<hash>/queue/     append one *.task file per task (drop-in)
 *   ~/.codex-loop/<hash>/done/      loop moves finished tasks here
 *   ~/.codex-loop/<hash>/log/       per-task output
 *   ~/.codex-loop/<hash>/loop.log   codex exec stdout (the living turn)
 *   ~/.codex-loop/<hash>/loop.pid   pid of the codex exec process
 *
 * Commands:
 *   codex-loop start [--cwd DIR] [--model M]   start the living turn
 *   codex-loop add "PROMPT"                    enqueue a task (drop a file)
 *   codex-loop status                          pid alive? queue depth?
 *   codex-loop stop                            kill the living turn
 *   codex-loop tail                            follow loop.log
 */

import { spawn } from 'node:child_process';
import { createHash } from 'node:crypto';
import { existsSync, mkdirSync, writeFileSync, readFileSync, readdirSync, unlinkSync, appendFileSync, openSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const CODEX_BIN = process.env.CODEX_LOOP_BIN || 'codex';

function baseDirFor(cwd) {
  const hash = createHash('sha256').update(cwd).digest('hex').slice(0, 12);
  return join(homedir(), '.codex-loop', hash);
}

function ensureLayout(base) {
  for (const d of ['', 'queue', 'done', 'log']) mkdirSync(join(base, d), { recursive: true });
}

function parseFlags(argv) {
  const o = { _: [] };
  const rest = [...argv];
  while (rest.length) {
    const a = rest.shift();
    if (a === '--cwd') o.cwd = rest.shift();
    else if (a === '--model') o.model = rest.shift();
    else o._.push(a);
  }
  return o;
}

function pidAlive(pid) {
  try { process.kill(pid, 0); return true; } catch { return false; }
}

function readPid(base) {
  try { const p = parseInt(readFileSync(join(base, 'loop.pid'), 'utf-8'), 10); return Number.isFinite(p) ? p : null; } catch { return null; }
}

/**
 * The living-turn instruction. Codex runs this as ONE turn and never returns a
 * final answer — it loops on the queue directory using its shell tool. Each
 * task file is processed then moved to done/. Empty queue → sleep → recheck.
 */
function loopPrompt(base) {
  const q = join(base, 'queue');
  const done = join(base, 'done');
  const log = join(base, 'log');
  return [
    'You are a RESIDENT WORKER running as a single never-ending turn. Do NOT end this turn or produce a final summary — keep working indefinitely.',
    '',
    'Your work queue is a directory of task files. Follow this loop forever:',
    '',
    `1. List task files: run \`ls -1 ${q}/*.task 2>/dev/null | sort\`.`,
    `2. If none exist, run \`sleep 3\` and go back to step 1. (Keep polling; never stop.)`,
    `3. Otherwise take the FIRST task file. Read its contents — that text is your next task.`,
    `4. Do the task fully. You MAY spawn subagents for it. Write any useful output to \`${log}/<taskfile-basename>.out\`.`,
    `5. When finished, move the task file to done: \`mv "<taskfile>" ${done}/\`.`,
    '6. Go back to step 1.',
    '',
    'Rules:',
    '- Never call it done. This turn must stay alive across usage-limit windows.',
    '- Process tasks strictly one at a time, oldest first.',
    '- If a task fails, still move it to done/ and record the error in its .out file, then continue.',
    '- Do not ask the user questions; act autonomously.',
    '',
    'Begin the loop now.',
  ].join('\n');
}

function startLoop(flags) {
  const cwd = flags.cwd || process.cwd();
  const base = baseDirFor(cwd);
  ensureLayout(base);

  const existing = readPid(base);
  if (existing && pidAlive(existing)) {
    console.log(`codex-loop: already running (pid ${existing}) for ${cwd}`);
    return;
  }

  const prompt = loopPrompt(base);
  const args = [
    'exec',
    '--dangerously-bypass-approvals-and-sandbox',
    '-C', cwd,
    '--skip-git-repo-check',
  ];
  if (flags.model) args.push('-m', flags.model);
  args.push(prompt);

  const out = openSync(join(base, 'loop.log'), 'a');
  const child = spawn(CODEX_BIN, args, {
    cwd,
    detached: true,
    stdio: ['ignore', out, out],
  });
  writeFileSync(join(base, 'loop.pid'), String(child.pid), { mode: 0o600 });
  child.unref();
  console.log(`codex-loop: started living turn (pid ${child.pid}) for ${cwd}`);
  console.log(`  queue: ${join(base, 'queue')}`);
  console.log(`  add work:  codex-loop add "your task"   (from ${cwd})`);
  console.log(`  watch:     codex-loop tail`);
}

function addTask(flags) {
  const cwd = flags.cwd || process.cwd();
  const base = baseDirFor(cwd);
  const prompt = flags._.join(' ').trim();
  if (!prompt) { console.error('codex-loop: no task text'); process.exit(2); }
  if (!existsSync(join(base, 'queue'))) { console.error(`codex-loop: no loop for ${cwd} — run 'codex-loop start' first`); process.exit(3); }
  // Monotonic-ish name without Date.now(): use hrtime + a counter file.
  const seqPath = join(base, '.seq');
  let seq = 0;
  try { seq = parseInt(readFileSync(seqPath, 'utf-8'), 10) || 0; } catch { /* ignore */ }
  seq += 1;
  try { writeFileSync(seqPath, String(seq)); } catch { /* ignore */ }
  const name = `${String(seq).padStart(6, '0')}.task`;
  writeFileSync(join(base, 'queue', name), prompt + '\n', { mode: 0o600 });
  const alive = readPid(base);
  console.log(`codex-loop: queued ${name}` + (alive && pidAlive(alive) ? '' : '  (WARNING: loop process not running — start it)'));
}

function statusLoop(flags) {
  const cwd = flags.cwd || process.cwd();
  const base = baseDirFor(cwd);
  const pid = readPid(base);
  const alive = pid ? pidAlive(pid) : false;
  let queued = 0, done = 0;
  try { queued = readdirSync(join(base, 'queue')).filter((f) => f.endsWith('.task')).length; } catch { /* ignore */ }
  try { done = readdirSync(join(base, 'done')).filter((f) => f.endsWith('.task')).length; } catch { /* ignore */ }
  console.log(JSON.stringify({ cwd, pid, alive, queued, done, base }));
}

function stopLoop(flags) {
  const cwd = flags.cwd || process.cwd();
  const base = baseDirFor(cwd);
  const pid = readPid(base);
  if (pid && pidAlive(pid)) {
    try { process.kill(pid, 'SIGTERM'); console.log(`codex-loop: stopped pid ${pid}`); } catch (e) { console.error('stop failed', String(e)); }
  } else {
    console.log('codex-loop: not running');
  }
  try { unlinkSync(join(base, 'loop.pid')); } catch { /* ignore */ }
}

function tailLoop(flags) {
  const cwd = flags.cwd || process.cwd();
  const base = baseDirFor(cwd);
  const f = join(base, 'loop.log');
  const t = spawn('tail', ['-f', f], { stdio: 'inherit' });
  process.on('SIGINT', () => { try { t.kill(); } catch {} process.exit(0); });
}

function main() {
  const [mode, ...argv] = process.argv.slice(2);
  const flags = parseFlags(argv);
  switch (mode) {
    case 'start': return startLoop(flags);
    case 'add': return addTask(flags);
    case 'status': return statusLoop(flags);
    case 'stop': return stopLoop(flags);
    case 'tail': return tailLoop(flags);
    default:
      console.log(`codex-loop — one living Codex turn fed by a file queue

  codex-loop start [--cwd DIR] [--model M]   start the living turn (do this while the window has headroom)
  codex-loop add "TASK"                      enqueue a task
  codex-loop status                          pid/queue depth
  codex-loop stop                            kill the living turn
  codex-loop tail                            follow the loop log
`);
      process.exit(mode ? 0 : 2);
  }
}

main();
